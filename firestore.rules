rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is a household member
    function isMember(householdId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }
    
    // Helper function to check if user is a household manager
    function isManager(householdId) {
      return isSignedIn() && 
             get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role == 'manager';
    }
    
    // Helper function to check if user is a rent-only member
    function isRentMember(householdId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/households/$(householdId)/rentBillMembers/$(request.auth.uid));
    }
    
    // User documents - each user can read all users but only write their own
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false; // Users cannot delete their profiles
    }
    
    // Household documents
    match /households/{householdId} {
      // ✅ FIXED: Anyone authenticated can read households (needed for invite code lookup)
      // This allows users to query households by invite code before joining
      allow read: if isSignedIn();
      
      // Any authenticated user can create a household
      allow create: if isSignedIn();
      
      // Only members can update household info
      allow update: if isMember(householdId);
      
      // Only managers can delete households
      allow delete: if isManager(householdId);
      
      // Members subcollection
      match /members/{memberId} {
        // ✅ FIXED: Anyone authenticated can read member list (needed to check capacity before joining)
        // This allows checking member count before joining household
        allow read: if isSignedIn();
        
        // New members can add themselves (when joining via invite code)
        // Managers can add/update any member
        allow create: if isSignedIn() && 
                        (request.auth.uid == memberId || isManager(householdId));
        
        // Members can update their own profile
        // Managers can update any member
        allow update: if isSignedIn() && 
                        (request.auth.uid == memberId || isManager(householdId));
        
        // Only managers can remove members
        allow delete: if isManager(householdId);
      }
      
      // Expenses subcollection
      match /expenses/{expenseId} {
        // All household members can read expenses
        allow read: if isMember(householdId);
        
        // Any household member can create an expense
        allow create: if isMember(householdId) && 
                        request.auth.uid == request.resource.data.createdBy;
        
        // Managers can update any expense (for approval/rejection)
        // Members can only update their own pending expenses
        allow update: if isSignedIn() && 
                        (isManager(householdId) || 
                         (request.auth.uid == resource.data.createdBy && 
                          resource.data.status == 'pending'));
        
        // Only managers can delete expenses
        allow delete: if isManager(householdId);
      }
      
      // Debts subcollection
      match /debts/{debtId} {
        // All household members can read debts
        allow read: if isMember(householdId);
        
        // Any household member can create a manual debt record
        // Auto debts are created by the system (createdBy: 'system')
        allow create: if isMember(householdId) && 
                        (request.auth.uid == request.resource.data.createdBy ||
                         request.resource.data.createdBy == 'system');
        
        // Managers can update any debt (for approval/rejection)
        // Debtors can update their own debts (for recording payments)
        // System can update auto debts
        // Only allow updates to approved debts if it's for payments
        allow update: if isSignedIn() && 
                        (isManager(householdId) || 
                         (request.auth.uid == resource.data.debtor && 
                          resource.data.status == 'approved') ||
                         (request.auth.uid == resource.data.createdBy && 
                          resource.data.status == 'pending') ||
                         (resource.data.type == 'auto' && isMember(householdId)));
        
        // Managers can delete debts
        // Auto debts can be deleted by the system
        allow delete: if isManager(householdId) || 
                        (resource.data.type == 'auto' && isMember(householdId));
      }
      
      // Rent-only Members subcollection
      match /rentBillMembers/{memberId} {
        // Managers and regular members can read (for viewing purposes)
        allow read: if isManager(householdId) || isMember(householdId);
        
        // Only managers can create rent members
        allow create: if isManager(householdId);
        
        // Only managers can update rent members
        allow update: if isManager(householdId);
        
        // Only managers can delete rent members
        allow delete: if isManager(householdId);
      }
      
      // Rent and Bills subcollection
      match /rentBills/{billId} {
        // Managers and regular members can read all rent/bills
        allow read: if isManager(householdId) || isMember(householdId);
        
        // Only managers can create rent/bills
        allow create: if isManager(householdId);
        
        // Only managers can update rent/bills
        allow update: if isManager(householdId);
        
        // Only managers can delete rent/bills
        allow delete: if isManager(householdId);
      }
    }
    
    // Personal Expenses - private to each user
    match /personalExpenses/{expenseId} {
      // Users can only read their own personal expenses
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      
      // Users can only create personal expenses for themselves
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      
      // Users can only update their own personal expenses
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      
      // Users can only delete their own personal expenses
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}

// Storage Rules (if you add file uploads in the future)
// Uncomment and adjust as needed

