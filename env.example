# Copy to .env and fill with your Firebase project values
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# WhatsApp Business API Configuration (Meta WhatsApp Cloud API)
# Get these from: https://developers.facebook.com/apps/
# 1. Create a Meta App at https://developers.facebook.com/apps/
# 2. Add WhatsApp product to your app
# 3. Get your Phone Number ID and Access Token from WhatsApp > API Setup
VITE_WHATSAPP_PHONE_NUMBER_ID=
VITE_WHATSAPP_ACCESS_TOKEN=
VITE_WHATSAPP_API_VERSION=v21.0

# Note: For production, it's recommended to use a backend/cloud function to securely handle WhatsApp API calls
# and store the access token server-side to avoid exposing it in the frontend.


